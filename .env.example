# Основные настройки приложения
APP_NAME="URL Shortener"
DEBUG=False
ENVIRONMENT=local
LOG_LEVEL=INFO

# Алфавит (набор символов), из которого Sqids генерирует короткие коды на основе числовых ID записей в БД
# Перемешанный порядок символов затрудняет подбор следующих кодов по предыдущим
# После создания ссылок менять нельзя: для декодирования уже созданных кодов нужен исходный алфавит
SQIDS_ALPHABET="vP7CuA8Kx3b6LgVz1oMw9RqT2YjHfN5sZ0XyD4mIeJtElWkchQpGBFaOrnUdiS"

# Базовый адрес сервиса для формирования коротких ссылок
BASE_URL=http://localhost

# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=shortener

# Кеш и брокер
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password